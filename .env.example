# ===================================================================
# Playlist API - Configuración de Variables de Entorno de Ejemplo
# NO colocar credenciales ni secretos reales en este archivo.
# Copiar a '.env' o exportar estas variables en el entorno de ejecución.
# ===================================================================

# Puerto del servidor Spring Boot (opcional, por defecto 8080)
SERVER_PORT=8080

# Configuración de Seguridad y JWT
# ADVERTENCIA DE SEGURIDAD:
# 1. JWT_SECRET es OBLIGATORIO de reemplazar en entornos de producción.
# 2. El algoritmo HS256 requiere una clave secreta mínima de 256 bits (32 bytes).
# 3. NUNCA subir secretos ni claves reales a repositorios de código fuente.
JWT_SECRET=PLEASE_OVERRIDE_IN_PRODUCTION_WITH_A_SECRET_KEY_OF_AT_LEAST_256_BITS_OR_32_BYTES
JWT_EXPIRATION=86400000
JWT_ISSUER=PlaylistAPI

# Credenciales de Spotify Web API (Obtenidas en Spotify Developer Dashboard)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_TOKEN_URL=https://accounts.spotify.com/api/token
SPOTIFY_API_URL=https://api.spotify.com/v1

# H2 Web Console (true para desarrollo local, false para producción)
H2_CONSOLE_ENABLED=true
